<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiToolKit.Gateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cached module specs: shown when a module is not running. Refreshed by start-modules.ps1 -RefreshSpecs. -->
    <Content Update="specs\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
