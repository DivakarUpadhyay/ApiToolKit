  "components": {
    "schemas": {
      "CreateFulfillmentRequest": {
        "required": [
          "fulfillmentOrderLineItems"
        ],
        "type": "object",
        "properties": {
          "fulfillmentOrderLineItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FulfillmentOrderDto2"
            }
          },
          "trackingInfo": {
            "$ref": "#/components/schemas/TrackingInfo"
          },
          "notifyCustomer": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateFulfillmentServiceRequest": {
        "required": [
          "callbackUrl",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "callbackUrl": {
            "minLength": 1,
            "type": "string"
          },
          "inventoryManagement": {
            "type": "boolean",
            "nullable": true
          },
          "trackingSupport": {
            "type": "boolean",
            "nullable": true
          },
          "requiresShippingMethod": {
            "type": "boolean",
            "nullable": true
          },
          "format": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FulfillmentOrderDto2": {
        "required": [
          "fulfillmentOrderId"
        ],
        "type": "object",
        "properties": {
          "fulfillmentOrderId": {
            "minLength": 1,
            "type": "string"
          },
          "fulfillmentOrderLineItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FulfillmentOrderLineItemDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FulfillmentOrderLineItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TrackingInfo": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "company": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateFulfillmentServiceRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "callbackUrl": {
            "type": "string",
            "nullable": true
          },
          "inventoryManagement": {
            "type": "boolean",
            "nullable": true
          },
          "trackingSupport": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateTrackingRequest": {
        "required": [
          "trackingInfo"
        ],
        "type": "object",
        "properties": {
          "trackingInfo": {
            "$ref": "#/components/schemas/TrackingInfo"
          },
          "notifyCustomer": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
