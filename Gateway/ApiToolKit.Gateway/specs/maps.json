{
  "openapi": "3.0.1",
  "info": {
    "title": "ApiToolKit - Google Maps Platform",
    "description": "ASP.NET Core Clean Architecture integration for all Google Maps Platform APIs. Covers Geocoding, Reverse Geocoding, Directions, Distance Matrix, Places (Nearby Search, Text Search, Details, Autocomplete, Photos), Elevation, Time Zone, Roads (Snap to Roads), and Static Maps.",
    "contact": {
      "name": "ApiToolKit",
      "email": "official@amplegroupglobal.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/maps/directions": {
      "get": {
        "tags": [
          "MapsDirections"
        ],
        "summary": "Get directions between two locations with optional waypoints.",
        "parameters": [
          {
            "name": "Origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Units",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Avoid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DepartureTime",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ArrivalTime",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Alternatives",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "WaypointsList",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
