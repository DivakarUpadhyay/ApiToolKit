{
  "openapi": "3.0.1",
  "info": {
    "title": "ApiToolKit - Google Search APIs (Custom Search & Knowledge Graph)",
    "description": "ASP.NET Core Clean Architecture integration for Google Custom Search API and Knowledge Graph Search API. Supports web search, image search, and entity lookup.",
    "contact": {
      "name": "ApiToolKit",
      "email": "official@amplegroupglobal.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/search/custom": {
      "get": {
        "tags": [
          "CustomSearch"
        ],
        "summary": "Perform a web search using the Google Custom Search API.",
        "description": "Returns up to 10 results per page. Use the Start parameter for pagination.\r\nThe Cx (Search Engine ID) parameter is optional — if omitted, the configured default is used.",
        "parameters": [
          {
            "name": "Q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Cx",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Num",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Start",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CountryRestrict",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DateRestrict",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ExactTerms",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ExcludeTerms",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FileType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Filter",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Gl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Hq",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LinkSite",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LowRange",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "HighRange",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "OrTerms",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Rights",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Safe",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SiteSearch",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SiteSearchFilter",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/search/custom/images": {
      "get": {
        "tags": [
          "CustomSearch"
        ],
        "summary": "Perform an image search using the Google Custom Search API.",
        "description": "Searches specifically for images. Supports filtering by ImageSize, ImageType, ImageColorType, and ImageDominantColor.",
        "parameters": [
          {
            "name": "Q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Cx",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Num",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Start",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Gl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
