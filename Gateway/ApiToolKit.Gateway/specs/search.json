            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ImageSize",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ImageType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FileType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Rights",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Safe",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/search/knowledge-graph": {
      "get": {
        "tags": [
          "KnowledgeGraph"
        ],
        "summary": "Search for entities in the Google Knowledge Graph.",
        "description": "Returns structured entity information including name, description, image, and detailed description.\r\nUse the Types parameter to filter by entity type (e.g., \"Person\", \"Organization\", \"Place\").\r\nResults are scored by relevance — higher ResultScore indicates a stronger match.",
        "parameters": [
          {
            "name": "Query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Types",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "LanguageCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Indent",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Prefix",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
