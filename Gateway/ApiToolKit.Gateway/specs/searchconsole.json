{
  "openapi": "3.0.1",
  "info": {
    "title": "ApiToolKit - Google Search Console & Indexing API",
    "description": "ASP.NET Core Clean Architecture integration for Search Console API (search analytics, keyword rankings, sites, sitemaps, URL inspection) and the Indexing API (job posting and livestream pages only). Connect a Google account with GET /api/searchconsole/auth/url?accountKey=..., then pass the same accountKey to every endpoint.",
    "contact": {
      "name": "ApiToolKit",
      "email": "official@amplegroupglobal.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/searchconsole/auth/url": {
      "get": {
        "tags": [
          "SearchConsoleAuth"
        ],
        "summary": "Get the Google OAuth 2.0 consent URL. accountKey is any name you choose for this Google account; reuse it on every other endpoint.",
        "parameters": [
          {
            "name": "accountKey",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/searchconsole/auth/callback": {
      "get": {
        "tags": [
          "SearchConsoleAuth"
        ],
        "summary": "OAuth 2.0 callback. Google sends the code and the accountKey (as state); tokens are stored for that account key.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/searchconsole/auth/token/refresh": {
      "post": {
        "tags": [
          "SearchConsoleAuth"
        ],
        "summary": "Refresh the stored access token for an account key.",
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Auth.RefreshTokenRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Auth.RefreshTokenRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Auth.RefreshTokenRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Auth.RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/indexing/publish": {
      "post": {
        "tags": [
          "SearchConsoleIndexing"
        ],
        "summary": "Tell Google a job posting or livestream URL was updated or deleted.",
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Indexing.PublishUrlNotificationRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Indexing.PublishUrlNotificationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Indexing.PublishUrlNotificationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.SearchConsole.Indexing.PublishUrlNotificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/indexing/metadata": {
      "get": {
        "tags": [
