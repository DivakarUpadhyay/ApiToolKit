{
  "openapi": "3.0.1",
  "info": {
    "title": "ApiToolKit - Shopify Auth API",
    "description": "ASP.NET Core integration for Shopify OAuth 2.0 - Install URL generation, callback handling, HMAC verification, and shop info.",
    "contact": {
      "name": "ApiToolKit",
      "email": "official@amplegroupglobal.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/shopify/auth/install-url": {
      "post": {
        "tags": [
          "ShopifyAuth"
        ],
        "summary": "Generate Shopify app install/authorization URL",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.GetInstallUrlRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.GetInstallUrlRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.GetInstallUrlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/auth/callback": {
      "post": {
        "tags": [
          "ShopifyAuth"
        ],
        "summary": "Handle OAuth callback - verify HMAC and exchange code for access token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.CallbackRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.CallbackRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.CallbackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/auth/shop": {
      "get": {
        "tags": [
          "ShopifyAuth"
        ],
        "summary": "Get shop information using stored access token",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/auth/verify-hmac": {
      "post": {
        "tags": [
          "ShopifyAuth"
        ],
        "summary": "Verify Shopify HMAC signature from query string",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.VerifyHmacRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.VerifyHmacRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Auth.VerifyHmacRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/auth/token": {
      "get": {
        "tags": [
          "ShopifyAuth"
        ],
        "summary": "Get stored access token for a shop",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "ShopifyAuth"
        ],
        "summary": "Revoke stored access token for a shop",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiToolKit.Application.DTOs.Shopify.Auth.CallbackRequest": {
        "required": [
          "code",
          "hmac",
          "shop",
          "state",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "shop": {
            "minLength": 1,
            "type": "string"
          },
          "hmac": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "minLength": 1,
            "type": "string"
          },
          "timestamp": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ApiToolKit.Application.DTOs.Shopify.Auth.GetInstallUrlRequest": {
        "required": [
          "shopDomain"
        ],
        "type": "object",
        "properties": {
          "shopDomain": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApiToolKit.Application.DTOs.Shopify.Auth.VerifyHmacRequest": {
        "required": [
          "queryString"
        ],
        "type": "object",
        "properties": {
          "queryString": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}