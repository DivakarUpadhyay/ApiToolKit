{
  "openapi": "3.0.1",
  "info": {
    "title": "ApiToolKit - Shopify Inventory API",
    "description": "Shopify Admin REST API for Inventory Items, Inventory Levels, and Locations.",
    "contact": {
      "name": "ApiToolKit",
      "email": "official@amplegroupglobal.com"
    },
    "version": "v1"
  },
  "paths": {
    "/api/shopify/inventory/items": {
      "get": {
        "tags": [
          "ShopifyInventoryItem"
        ],
        "summary": "List inventory items by IDs",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/inventory/items/{inventoryItemId}": {
      "get": {
        "tags": [
          "ShopifyInventoryItem"
        ],
        "summary": "Get a single inventory item by ID",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inventoryItemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "ShopifyInventoryItem"
        ],
        "summary": "Update an inventory item (cost, tracked)",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inventoryItemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.UpdateInventoryItemRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.UpdateInventoryItemRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.UpdateInventoryItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/inventory/levels": {
      "get": {
        "tags": [
          "ShopifyInventoryLevel"
        ],
        "summary": "List inventory levels by inventory item IDs and/or location IDs",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inventoryItemIds",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locationIds",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "ShopifyInventoryLevel"
        ],
        "summary": "Disconnect an inventory item from a location",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inventoryItemId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/inventory/levels/adjust": {
      "post": {
        "tags": [
          "ShopifyInventoryLevel"
        ],
        "summary": "Adjust inventory level quantity",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.AdjustInventoryLevelRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.AdjustInventoryLevelRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.AdjustInventoryLevelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/inventory/levels/connect": {
      "post": {
        "tags": [
          "ShopifyInventoryLevel"
        ],
        "summary": "Connect an inventory item to a location",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.ConnectInventoryLevelRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.ConnectInventoryLevelRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.ConnectInventoryLevelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/inventory/levels/set": {
      "post": {
        "tags": [
          "ShopifyInventoryLevel"
        ],
        "summary": "Set absolute inventory level quantity",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.SetInventoryLevelRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.SetInventoryLevelRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToolKit.Application.DTOs.Shopify.Inventory.SetInventoryLevelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/locations": {
      "get": {
        "tags": [
          "ShopifyLocation"
        ],
        "summary": "List all locations",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/locations/count": {
      "get": {
        "tags": [
          "ShopifyLocation"
        ],
        "summary": "Count all locations",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/locations/{locationId}": {
      "get": {
        "tags": [
          "ShopifyLocation"
        ],
        "summary": "Get a location by ID",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/shopify/locations/{locationId}/inventory-levels": {
      "get": {
        "tags": [
          "ShopifyLocation"
        ],
        "summary": "Get inventory levels at a location",
        "parameters": [
          {
            "name": "shopDomain",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiToolKit.Application.DTOs.Shopify.Inventory.AdjustInventoryLevelRequest": {
        "required": [
          "availableAdjustment",
          "inventoryItemId",
          "locationId"
        ],
        "type": "object",
        "properties": {
          "inventoryItemId": {
            "minLength": 1,
            "type": "string"
          },
          "locationId": {
            "minLength": 1,
            "type": "string"
          },
          "availableAdjustment": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ApiToolKit.Application.DTOs.Shopify.Inventory.ConnectInventoryLevelRequest": {
        "required": [
          "inventoryItemId",
          "locationId"
        ],
        "type": "object",
        "properties": {
          "inventoryItemId": {
            "minLength": 1,
            "type": "string"
          },
          "locationId": {
            "minLength": 1,
            "type": "string"
          },
          "relocateIfNecessary": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApiToolKit.Application.DTOs.Shopify.Inventory.SetInventoryLevelRequest": {
        "required": [
          "available",
          "inventoryItemId",
          "locationId"
        ],
        "type": "object",
        "properties": {
          "inventoryItemId": {
            "minLength": 1,
            "type": "string"
          },
          "locationId": {
            "minLength": 1,
            "type": "string"
          },
          "available": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ApiToolKit.Application.DTOs.Shopify.Inventory.UpdateInventoryItemRequest": {
        "type": "object",
        "properties": {
          "tracked": {
            "type": "boolean",
            "nullable": true
          },
          "cost": {
            "type": "string",
            "nullable": true
          },
          "countryCodeOfOrigin": {
            "type": "string",
            "nullable": true
          },
          "harmonizedSystemCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}