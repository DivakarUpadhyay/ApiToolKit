      "get": {
        "tags": [
          "CloudAuth"
        ],
        "summary": "Returns the Google OAuth 2.0 authorization URL to redirect the user to.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/cloud/auth/callback": {
      "get": {
        "tags": [
          "CloudAuth"
        ],
