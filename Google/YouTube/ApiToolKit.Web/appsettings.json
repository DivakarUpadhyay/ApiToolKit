{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ApiToolKit;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Google": {
    "YouTube": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "RedirectUri": "http://localhost:5033/api/youtube/auth/callback",
      "ApiKey": "YOUR_GOOGLE_API_KEY"
    }
  }
}
