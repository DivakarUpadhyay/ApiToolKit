# ── Shopee Sandbox Credentials ───────────────────────────────────────────────
# Get these from: https://open.shopee.com → My Apps → Your App → Credentials
SHOPEE_PARTNER_ID=YOUR_PARTNER_ID
SHOPEE_PARTNER_KEY=YOUR_PARTNER_KEY
SHOPEE_SANDBOX_BASE_URL=https://partner.test-stable.shopeemobile.com

# After OAuth flow, set these to test shop-level APIs
# Step 1: Call GET /api/shopee/auth/auth-url to get the auth URL
# Step 2: Open that URL in browser, authorize a test shop
# Step 3: Shopee redirects to your callback with ?code=XXX&shop_id=YYY
# Step 4: Call POST /api/shopee/auth/token with code + shop_id
# Step 5: Copy the access_token and shop_id here
SHOPEE_TEST_SHOP_ID=0
SHOPEE_TEST_ACCESS_TOKEN=

# ── Flipkart Seller API Credentials ──────────────────────────────────────────
# Get these from: https://seller.flipkart.com → Settings → API → Generate Access Token
FLIPKART_BASE_URL=https://api.flipkart.net/sellers
FLIPKART_ACCESS_TOKEN=YOUR_FLIPKART_ACCESS_TOKEN

# After requesting a report, paste the returned report_id here to test report detail
FLIPKART_REPORT_ID=
